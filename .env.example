# Tiruno configuration — copy to .env.local and fill in what you need.
#
# Tiruno runs with ZERO config: no keys, no infra. Every subsystem is a pluggable
# provider that auto-detects from these vars and gracefully falls back. Add a key
# to light up a capability. Full matrix: see PROVIDERS.md.

# ─────────────────────────────────────────────────────────────────────────────
# LLM (reasoning) — used for orchestration, lessons, Hermes reflection, summaries
# Provider auto-detect order: ANTHROPIC_API_KEY -> OPENAI_API_KEY -> OLLAMA_HOST.
# Force one with LLM_PROVIDER. With none set, callers use built-in heuristics.
# ─────────────────────────────────────────────────────────────────────────────
# DEFAULT: run the WHOLE app on your Claude subscription (no API key billing).
# Requires the `claude` CLI logged in (`claude login`) and @anthropic-ai/claude-agent-sdk.
# The claude-agent provider/runner strip ANTHROPIC_API_KEY before calling the SDK, so
# Claude billing always goes through the subscription even if a key is present.
LLM_PROVIDER=claude-agent          # claude-agent (subscription) | anthropic | openai | ollama
# CLAUDE_MODEL=
# AGENT_CWD=                       # cwd for the agent SDK (defaults to process.cwd())
# AGENT_RUNNER=                    # claude | llm — force the agent runner

# Anthropic API (pay-as-you-go API billing) — OPT-IN ONLY. Not used unless you set
# LLM_PROVIDER=anthropic. Leaving a key here does NOT switch billing to the API while
# LLM_PROVIDER=claude-agent.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (also usable for STT/TTS and embeddings)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama — fully local, free, no API key. `ollama serve` + `ollama pull llama3.1`
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ─────────────────────────────────────────────────────────────────────────────
# Storage — REDIS_URL/REDIS_HOST => Redis; otherwise in-memory (zero infra).
# The worker<->app realtime (SSE) needs real Redis; single-process features work
# in memory. Force with STORE_PROVIDER.
# ─────────────────────────────────────────────────────────────────────────────
# STORE_PROVIDER=redis             # redis | memory
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PWD=
# REDIS_SSL=false

# ─────────────────────────────────────────────────────────────────────────────
# Voice (TTS/STT) — auto-detect: DEEPGRAM -> OPENAI -> ELEVENLABS.
# With none set, the browser's built-in WebSpeech is used (zero key).
# ─────────────────────────────────────────────────────────────────────────────
# VOICE_PROVIDER=deepgram          # deepgram | openai | elevenlabs
# DEEPGRAM_API_KEY=
# DEEPGRAM_TTS_MODEL=aura-2-apollo-en
# DEEPGRAM_STT_MODEL=nova-3
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings (RAG / vector search) — auto-detect: OLLAMA -> OPENAI -> local.
# DEFAULT: Ollama (local, free) via `docker compose up`. The embed model MUST be
# 1024-dim to match the vector index (EMBED_DIM) — mxbai-embed-large is 1024.
# "local" is a deterministic hashing embedder (no key/infra, lower quality).
# ─────────────────────────────────────────────────────────────────────────────
EMBED_PROVIDER=ollama              # ollama | openai | local
OLLAMA_EMBED_MODEL=mxbai-embed-large
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────────────────────────────────────
# Summarizer — picks the best available: NotebookLM (if enabled) -> LLM -> local.
# The LLM summarizer gives clear, grounded summaries; "local" is extractive.
# ─────────────────────────────────────────────────────────────────────────────
# SUMMARIZER=llm                   # notebooklm | llm | local
# NOTEBOOKLM_ENABLED=0             # 1 to try NotebookLM via the CLI first
# NOTEBOOKLM_CMD=notebooklm-mcp-cli summarize   # summarizer command (embeds the verb)
# NOTEBOOKLM_TIMEOUT_MS=120000

# ─────────────────────────────────────────────────────────────────────────────
# NotebookLM ingestion pipeline — ingest articles/emails as NotebookLM sources,
# generate podcast + lessons, and rotate sources under the per-notebook cap.
# Uses the real notebooklm-mcp-cli (binary `nlm`):
#   uv tool install notebooklm-mcp-cli   # installs the `nlm` binary on PATH
#   nlm login                            # authenticate the Google session (once)
# The client appends its own command tokens, so NOTEBOOKLM_CLI is a *base*
# command only (no verb). Validate the live contract + auth any time with:
#   NOTEBOOKLM_ENABLED=1 npx tsx scripts/notebooklm-doctor.ts [--roundtrip]
# ─────────────────────────────────────────────────────────────────────────────
# NOTEBOOKLM_MOCK=0                # 1 = hermetic in-memory simulator (no CLI / Google session)
# NOTEBOOKLM_CLI=nlm                          # ingestion CLI base command (the `nlm` binary)
# NOTEBOOKLM_PROFILE=                         # optional `nlm --profile` (multi-account sessions)
# Notebook ids are NotebookLM's opaque ids OR `nlm alias` names. Easiest setup:
#   nlm alias set articles <real-notebook-id>
#   nlm alias set courses  <real-notebook-id>
# NOTEBOOKLM_NOTEBOOK_COURSES=courses          # notebook id/alias for durable course material
# NOTEBOOKLM_NOTEBOOK_ARTICLES=articles        # notebook id/alias for rotating articles/emails
# NOTEBOOKLM_RETENTION_DAYS=7      # how long an ingested source is kept (engagement extends it)
# NOTEBOOKLM_SOURCE_CAP=50         # per-notebook source cap (drives rotation/eviction)
# NOTEBOOKLM_DATA_DIR=data/materials           # converted .md files + downloaded podcasts (.m4a)
# NOTEBOOKLM_CLEANUP_INTERVAL_MS=3600000       # worker rotation timer (0 disables; default 1h when enabled)
# NOTEBOOKLM_AUTO_INGEST=1                      # curator auto-ingests discovered URLs (set 0 to disable)
# Audio overview is async (create → poll studio status → download):
# NOTEBOOKLM_AUDIO_FORMAT=deep_dive            # deep_dive | brief | critique | debate
# NOTEBOOKLM_AUDIO_LENGTH=default              # short | default | long
# NOTEBOOKLM_AUDIO_POLL_MS=5000                # studio-status poll interval while generating
# NOTEBOOKLM_AUDIO_TIMEOUT_MS=600000           # give up after this long (also caps --file --wait)
# Override CLI command tokens if your build differs (space-separated):
# NOTEBOOKLM_SUB_ADDSOURCE=source add
# NOTEBOOKLM_SUB_LISTSOURCES=source list
# NOTEBOOKLM_SUB_DELETESOURCE=source delete
# NOTEBOOKLM_SUB_AUDIOCREATE=audio create
# NOTEBOOKLM_SUB_STUDIOSTATUS=studio status
# NOTEBOOKLM_SUB_DOWNLOADAUDIO=download audio

# ─────────────────────────────────────────────────────────────────────────────
# Gmail ingestion — pull newsletter bodies and ingest them as file sources.
# ─────────────────────────────────────────────────────────────────────────────
# GMAIL_MOCK=0                     # 1 = canned newsletters (no inbox needed)
# GMAIL_ENABLED=0                  # 1 + GMAIL_CMD to use a real Gmail MCP CLI
# GMAIL_CMD=                       # e.g. "gmail-mcp-cli newsletters" (emits {messages:[...]})
# GMAIL_POLL_INTERVAL_MS=0         # worker Gmail poll timer (0 disables)
# WORKER_MAX_ATTEMPTS=3            # job retries before dead-lettering to jobs:agent:dead

# ─────────────────────────────────────────────────────────────────────────────
# Vault (Obsidian) — agent memory, strategies, skills, reflections as markdown.
# ─────────────────────────────────────────────────────────────────────────────
# VAULT_PROVIDER=obsidian
# TIRUNO_VAULT_DIR=./vault         # point an Obsidian vault here to browse memory
