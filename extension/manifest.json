{
  "manifest_version": 3,
  "name": "Tiruno Companion",
  "version": "0.1.0",
  "description": "Bookmark articles into Tiruno (Tiru summarises & explains them) and connect Canvas.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tiruno Companion"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:3002/*",
    "http://localhost:3000/*",
    "https://*.instructure.com/*"
  ]
}
